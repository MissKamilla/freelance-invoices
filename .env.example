# База даних (docker compose: postgres на порту 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/invoices

# Better Auth: для локального запуску підійде будь-який рядок від 32 символів
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Кнопка «Демо-вхід» і демо-акаунт
DEMO_MODE=true

# Пошта (Mailpit: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Freelance Invoices <no-reply@freelance.local>"

# Inngest Dev Server (http://localhost:8288)
INNGEST_DEV=1
# true → нагадування через 1 і 2 хвилини замість днів (для демо)
REMINDER_DEMO_MODE=false

# Оплата: mock (без ключів) або monobank (потрібен тестовий токен з https://api.monobank.ua/)
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=local-mock-webhook-secret
MONOBANK_TOKEN=
# Публічний https-URL (тунель) — лише якщо потрібні вебхуки monobank
PUBLIC_URL=
